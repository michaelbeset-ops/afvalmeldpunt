---
import Basis from '../layouts/Basis.astro';
import Hero from '../components/Hero.astro';
import HoeHetWerkt from '../components/HoeHetWerkt.astro';
import Meldflow from '../components/Meldflow.astro';
import Dashboard from '../components/Dashboard.astro';
import Sensor from '../components/Sensor.astro';
import Inzicht from '../components/Inzicht.astro';
import VoorWie from '../components/VoorWie.astro';
import PlaatjeSectie from '../components/PlaatjeSectie.astro';
import Bewoners from '../components/Bewoners.astro';
import Vragen from '../components/Vragen.astro';
import Afsluiter from '../components/Afsluiter.astro';
import Footer from '../components/Footer.astro';
import { VRAGEN } from '../lib/vragen';
import { serviceNode, faqNode } from '../lib/schema';

// Landelijk aanbod: de dienst geldt voor heel Nederland, niet voor losse plaatsen.
const dienst = {
  ...serviceNode({
    name: 'Meldsysteem tegen bijplaatsing bij ondergrondse containers',
    path: '/',
    serviceType: 'Meldsysteem met QR-code voor ondergrondse afvalcontainers',
    description: 'Een aluminium plaatje met eigen QR-code op elke ondergrondse afvalcontainer. Bewoners scannen de code en melden zonder app of account bijplaatsing, een volle of kapotte container, stank of ongedierte. De beheerder ziet alle meldingen per container in een online beheeromgeving, zodat zichtbaar wordt waar bijplaatsing steeds terugkomt.',
  }),
  areaServed: { '@type': 'Country', name: 'Nederland' },
  audience: { '@type': 'Audience', audienceType: 'Gemeenten, afvalinzamelaars en woningcorporaties' },
};
const schema = [dienst, faqNode(VRAGEN.map(([q, a]) => ({ q, a })))];
---
<Basis
  titel="Meldsysteem tegen bijplaatsing met QR-code | afvalmeldpunt"
  omschrijving="QR-code op elke ondergrondse container: bewoners melden bijplaatsing of een volle of kapotte container zonder app. U ziet alle meldingen per container."
  schema={schema}
>
  <main id="hoofdinhoud">
    <Hero />
    <HoeHetWerkt />
    <Meldflow />
    <Sensor />
    <Dashboard />
    <Inzicht />
    <VoorWie />
    <PlaatjeSectie />
    <Bewoners />
    <Vragen />
    <Afsluiter />
  </main>
  <Footer />
</Basis>
