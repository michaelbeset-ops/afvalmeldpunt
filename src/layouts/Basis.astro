---
import { pad } from '../lib/pad';
import '../styles/global.css';
import Cookiemelding from '../components/Cookiemelding.astro';
import SEO from '../components/SEO.astro';
// Alle SEO-tags (title, description, canonical, robots, Open Graph, JSON-LD) komen uit <SEO>,
// gevoed door seo.config.json. noindex komt uit de prop of uit ignorePaths in de config.
interface Props { titel: string; omschrijving: string; noindex?: boolean; pageType?: string; schema?: Record<string, unknown>[] }
const { titel, omschrijving, noindex = false, pageType, schema = [] } = Astro.props;
const ogAlt = 'Aluminium plaatje met QR-code van afvalmeldpunt, met de kop: Melden bij de container zelf, met één scan.';
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={titel} description={omschrijving} noindex={noindex} pageType={pageType} imageAlt={ogAlt} schema={schema} />
    <link rel="manifest" href={pad("/site.webmanifest")} />
    <link rel="alternate" type="text/markdown" title="Samenvatting voor AI-assistenten" href={pad("/llms.txt")} />
    <meta name="theme-color" content="#142019" />
  </head>
  <body>
    <a href="#hoofdinhoud" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-wit focus:px-4 focus:py-2 focus:font-semibold focus:text-inkt">Naar de inhoud</a>
    <slot />
    <Cookiemelding />
  </body>
</html>
