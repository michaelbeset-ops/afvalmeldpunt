---
// Drie haltes op één doorlopende lijn, zoals een melding ook echt reist: van het plaatje
// op straat, via de telefoon, naar het dashboard. Bewust geen drie gelijke kaartjes.
const haltes = [
  {
    kop: 'Op de container',
    tekst: 'Elke ondergrondse container krijgt een eigen aluminium plaatje met QR-code.',
    icoon: '<rect x="9" y="5" width="22" height="30" rx="3"/><rect x="13" y="14" width="14" height="14" rx="1"/><path d="M16 17h3v3h-3zM21 22h3v3h-3z"/><path d="M13 9h9"/>',
  },
  {
    kop: 'Op de telefoon van de bewoner',
    tekst: 'Scannen, kiezen wat er aan de hand is, eventueel een foto erbij en versturen. Gewoon in de browser, zonder app of account.',
    icoon: '<rect x="11" y="3" width="18" height="34" rx="4"/><path d="M18 7h4"/><path d="M15 16h10M15 21h10M15 26h6"/>',
  },
  {
    kop: 'In uw dashboard',
    tekst: 'De melding staat bij de juiste container. Zo ziet u per container wat er gemeld is.',
    icoon: '<rect x="3" y="7" width="34" height="23" rx="2"/><path d="M14 35h12M20 30v5"/><path d="M3 13h34M12 13v17"/><path d="M16 18h16M16 23h11"/>',
  },
];
---
<section id="hoe-het-werkt" class="bg-papier-2 py-20 sm:py-28" aria-labelledby="hoe-kop">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:px-16">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-16">
        <h2 id="hoe-kop" class="max-w-[12ch] text-[clamp(2rem,1.4rem+2.4vw,3.25rem)]">Van container tot dashboard</h2>
        <p class="mt-5 max-w-[26rem] text-lg">Zo loopt een melding, van de straat tot bij u op het scherm.</p>
      </div>
    </div>

    <ol class="route relative lg:col-span-6 lg:col-start-7">
      {haltes.map((h, i) => (
        <li class="halte relative grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-5 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:gap-x-8">
          <div class="relative z-10 grid h-14 w-14 place-items-center rounded-md border-2 border-inkt bg-papier-2 text-inkt sm:h-[4.5rem] sm:w-[4.5rem]">
            <svg class="h-8 w-8 sm:h-10 sm:w-10" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" set:html={h.icoon} />
          </div>
          <div class={i < haltes.length - 1 ? 'pb-14 sm:pb-20' : ''}>
            <h3 class="pt-2 text-[1.625rem] sm:pt-4 sm:text-[2rem]">{h.kop}</h3>
            <p class="mt-3 max-w-[30rem] text-lg">{h.tekst}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Elk lijnstuk loopt van een halte naar de volgende, dus niet voorbij de laatste. */
  .halte:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1.75rem - 1.5px);
    top: 3.5rem;
    bottom: 0;
    width: 3px;
    background: var(--color-fris);
    border-radius: 2px;
  }
  @media (min-width: 640px) {
    .halte:not(:last-child)::before { left: calc(2.25rem - 1.5px); top: 4.5rem; }
  }
</style>
