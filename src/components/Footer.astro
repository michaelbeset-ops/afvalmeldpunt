---
import { pad } from '../lib/pad';
import { BEDRIJF } from '../lib/bedrijf';
import Logo from './Logo.astro';
const links = [
  ['/#hoe-het-werkt', 'Hoe het werkt'],
  ['/#meldflow', 'Zo meldt een bewoner'],
  ['/#dashboard', 'Het dashboard'],
  ['/#vragen', 'Veelgestelde vragen'],
  ['/#melden', 'Voor bewoners'],
];
const service = [
  ['/contact/', 'Demo aanvragen'],
  ['/inloggen/', 'Inloggen'],
  ['/privacy/', 'Privacyverklaring'],
  ['/privacy/#cookie-instellingen', 'Cookie-instellingen'],
];
---
<footer class="bg-inkt pt-14 pb-8 text-op-donker sm:pt-20">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-12 lg:px-16">
    <div class="sm:col-span-2 lg:col-span-4">
      <Logo class="h-8 w-auto" merkKleur="#ffffff" oogKleur="#8fd1a8" tekstKleur="#ffffff" />
      <p class="mt-4 max-w-[22rem]">Meldsysteem met QR-code voor ondergrondse afvalcontainers.</p>
    </div>
    <nav aria-label="Product" class="lg:col-span-3 lg:col-start-6">
      <p class="font-semibold text-op-donker-sterk">Product</p>
      <ul class="mt-3 grid gap-2">
        {links.map(([h, n]) => <li><a class="hover:text-wit hover:underline" href={pad(h)}>{n}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Service" class="lg:col-span-2">
      <p class="font-semibold text-op-donker-sterk">Service</p>
      <ul class="mt-3 grid gap-2">
        {service.map(([h, n]) => <li><a class="hover:text-wit hover:underline" href={pad(h)}>{n}</a></li>)}
      </ul>
    </nav>
    <div class="lg:col-span-2">
      <p class="font-semibold text-op-donker-sterk">Contact</p>
      <p class="mt-3"><a class="hover:text-wit hover:underline" href={`mailto:${BEDRIJF.email}`}>{BEDRIJF.email}</a></p>
    </div>
    <div class="flex flex-col gap-2 border-t border-wit/15 pt-6 text-sm sm:col-span-2 sm:flex-row sm:justify-between lg:col-span-12">
      <p>&copy; {new Date().getFullYear()} afvalmeldpunt is een product van {BEDRIJF.naam} &middot; KvK {BEDRIJF.kvk}</p>
      <p>Gemaakt door <a class="font-semibold text-op-donker-sterk hover:text-wit hover:underline" href={BEDRIJF.website}>Sitefront</a></p>
    </div>
  </div>
</footer>
