---
// Demoformulier. Met een Web3Forms-key gaat het als gewone post naar Web3Forms (honeypot
// "botcheck" tegen spam). Zonder key opent het een kant-en-klare mail, zodat het formulier
// nooit doodloopt.
import { pad } from '../lib/pad';
import { BEDRIJF, WEB3FORMS_KEY } from '../lib/bedrijf';
const veld = 'w-full rounded-md border border-inkt/30 bg-wit px-3.5 py-3 text-base text-inkt transition-colors focus:border-bos focus:outline-none focus-visible:outline-3 focus-visible:outline-fris';
---
<form class="demoformulier grid gap-5" action="https://api.web3forms.com/submit" method="POST" data-key={WEB3FORMS_KEY} data-mail={BEDRIJF.email}>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="Demo-aanvraag via afvalmeldpunt.nl" />
  <input type="hidden" name="from_name" value="afvalmeldpunt.nl" />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="grid gap-1.5"><span class="font-semibold text-inkt">Naam</span><input class={veld} type="text" name="naam" autocomplete="name" required /></label>
    <label class="grid gap-1.5"><span class="font-semibold text-inkt">Organisatie</span><input class={veld} type="text" name="organisatie" autocomplete="organization" required /></label>
    <label class="grid gap-1.5"><span class="font-semibold text-inkt">E-mailadres</span><input class={veld} type="email" name="email" autocomplete="email" required /></label>
    <label class="grid gap-1.5"><span class="font-semibold text-inkt">Telefoonnummer <span class="font-normal text-tekst-2">(optioneel)</span></span><input class={veld} type="tel" name="telefoon" autocomplete="tel" /></label>
  </div>
  <label class="grid gap-1.5">
    <span class="font-semibold text-inkt">Om hoeveel containers gaat het? <span class="font-normal text-tekst-2">(optioneel)</span></span>
    <select class={veld} name="containers">
      <option value="">Maak een keuze</option>
      <option>Minder dan 50</option>
      <option>50 tot 250</option>
      <option>250 tot 1000</option>
      <option>Meer dan 1000</option>
      <option>Weet ik nog niet</option>
    </select>
  </label>
  <label class="grid gap-1.5"><span class="font-semibold text-inkt">Bericht <span class="font-normal text-tekst-2">(optioneel)</span></span><textarea class={veld} name="bericht" rows="4"></textarea></label>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <button type="submit" class="knop inline-flex items-center gap-2.5 rounded-md bg-bos px-5 py-3.5 font-display text-base font-bold text-wit shadow-knop transition-colors duration-200 hover:bg-bos-diep disabled:opacity-60">
      Demo aanvragen
      <svg class="pijl h-4 w-4 transition-transform duration-200" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <p class="max-w-[22rem] text-sm text-tekst-2">We gebruiken uw gegevens alleen om contact met u op te nemen over deze aanvraag. Zie de <a class="font-semibold text-bos underline underline-offset-2" href={pad("/privacy/")}>privacyverklaring</a>.</p>
  </div>
  <p class="melding hidden rounded-md px-4 py-3 font-semibold" role="status" aria-live="polite"></p>
</form>

<style>
  .knop:hover .pijl { transform: translateX(3px); }
  .melding.goed { display: block; background: #e3f0e8; color: var(--color-bos-diep); }
  .melding.fout { display: block; background: #f6e7e4; color: #8a2a1b; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.demoformulier');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const melding = form.querySelector<HTMLElement>('.melding')!;
    const knop = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const data = new FormData(form);
    melding.className = 'melding hidden rounded-md px-4 py-3 font-semibold';

    if (!form.dataset.key) {
      const regels = [['Naam', 'naam'], ['Organisatie', 'organisatie'], ['E-mailadres', 'email'], ['Telefoon', 'telefoon'], ['Aantal containers', 'containers'], ['Bericht', 'bericht']]
        .map(([label, veld]) => `${label}: ${data.get(veld) || '-'}`);
      location.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent('Demo-aanvraag afvalmeldpunt')}&body=${encodeURIComponent(regels.join('\n'))}`;
      melding.textContent = `Uw mailprogramma opent met de aanvraag. Opent er niets? Mail dan naar ${form.dataset.mail}.`;
      melding.classList.add('goed');
      return;
    }

    knop.disabled = true;
    try {
      const r = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await r.json();
      if (!r.ok || !json.success) throw new Error(json.message);
      form.reset();
      melding.textContent = 'Bedankt, uw aanvraag is verstuurd. We nemen contact met u op.';
      melding.classList.add('goed');
    } catch {
      melding.textContent = `Versturen lukte niet. Mail ons gerust op ${form.dataset.mail}.`;
      melding.classList.add('fout');
    } finally {
      knop.disabled = false;
    }
  });
</script>
