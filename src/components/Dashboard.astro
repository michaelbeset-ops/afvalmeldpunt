---
// Een blik op het beheeroverzicht, bewust beperkt: menu, kerncijfers en een paar rijen.
// Hoe meldingen worden afgehandeld, filters en exports laten we zien in een demo, niet hier.
// Sober en in Nunito, zodat het als software oogt. Een melding van de telefoon hierboven komt
// binnen bij container 0123 (event "afvalmeldpunt:melding"). Alle gegevens zijn demogegevens.
import '@fontsource-variable/nunito/wght.css';
import { pad } from '../lib/pad';
import { merkPaden } from '../lib/merk.mjs';

const rijen = [
  { nr: '0123', locatie: 'Kerkstraat 12', wijk: 'Centrum', status: 'Actief', open: 3 },
  { nr: '0187', locatie: 'Stationsplein 3', wijk: 'Stationsgebied', status: 'Defect', open: 1 },
  { nr: '0124', locatie: 'Kerkstraat 12', wijk: 'Centrum', status: 'Actief', open: 0 },
  { nr: '0210', locatie: 'Molenweg 40', wijk: 'Molenwijk', status: 'Actief', open: 0 },
  { nr: '0211', locatie: 'Molenweg 40', wijk: 'Molenwijk', status: 'In onderhoud', open: 0 },
];
const kaarten = [
  ['Open meldingen', '2 containers', 'in Demo-gemeente'],
  ['Bijna vol', '1 container', 'volgens de vulgraadsensor'],
  ['Bijplaatsing', '1 container', 'afval naast de container'],
  ['Defect', '1 container', 'wacht op reparatie'],
];
const menu = ['Dashboard', 'Containers', 'Meldingen', 'Gebruikers', 'QR-codes'];
---
<section id="dashboard" class="relative overflow-hidden bg-grond py-20 text-op-donker-sterk sm:py-28" aria-labelledby="dash-kop">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-16">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="dash-kop" class="max-w-[14ch] text-[clamp(2rem,1.4rem+2.4vw,3.25rem)] text-wit lg:col-span-6">Alle meldingen, per container</h2>
      <p class="max-w-[32rem] text-lg lg:col-span-5 lg:col-start-8">De beheerder ziet per container wat er gemeld is, waar en wanneer. Zo blijft er niets liggen.</p>
    </div>

    <div class="app relative mt-12 overflow-hidden rounded-md sm:mt-16" role="group" aria-label="Voorbeeld van het beheeroverzicht van afvalmeldpunt, met containers en open meldingen">
      <div class="nav" aria-hidden="true">
        <div class="binnen flex h-full items-center gap-6">
          <span class="flex shrink-0 items-center gap-1.5">
            <svg viewBox="0 0 48 48" class="h-6 w-6"><g set:html={merkPaden('#1c6a43', '#3f9f64')} /></svg>
            <span class="leading-none"><span class="block text-[0.75rem] font-semibold text-[#1c6a43]">AFVALMELDPUNT</span><span class="block text-[0.5rem] text-[#1c6a43]">Meldingen &amp; containerbeheer</span></span>
          </span>
          <span class="hidden h-full items-stretch lg:flex">
            {menu.map((m) => <span class={`navlink ${m === 'Containers' ? 'actief' : ''}`}>{m}</span>)}
          </span>
          <span class="ml-auto hidden items-center gap-1.5 whitespace-nowrap text-[#374151] sm:flex">B. Hendriks <svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg></span>
          <svg class="ml-auto text-[#4b5563] sm:hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </div>
      </div>

      <div class="titelbalk" aria-hidden="true"><p class="binnen">Beheeroverzicht</p></div>

      <div class="werkruimte" aria-hidden="true">
        <div class="binnen">
          <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
            {kaarten.map(([t, w, s]) => (
              <div class="kaart kpi"><p class="text-[0.8125rem] text-[#4b5563]">{t}</p><p class="waarde">{w}</p><p class="mt-1 text-[0.75rem] text-[#4b5563]">{s}</p></div>
            ))}
          </div>

          <div class="kaart mt-4 overflow-hidden">
            <table class="w-full border-collapse text-left">
              <thead>
                <tr><th>Container</th><th class="hidden md:table-cell">Locatie</th><th class="hidden lg:table-cell">Wijk</th><th class="hidden sm:table-cell">Status</th><th class="text-right">Meldingen</th></tr>
              </thead>
              <tbody>
                {rijen.map((r) => (
                  <tr class="rij" data-nr={r.nr}>
                    <td><span class="text-[#111827]">{r.nr}</span><span class="block text-[0.75rem] text-[#4b5563] md:hidden">{r.locatie}</span></td>
                    <td class="hidden md:table-cell">{r.locatie}</td>
                    <td class="hidden lg:table-cell">{r.wijk}</td>
                    <td class="hidden sm:table-cell">{r.status}</td>
                    <td class="text-right" data-open={r.open}>{r.open ? `${r.open} open` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- De rest laten we zien in een demo. -->
      <div class="sluier">
        <p class="font-display text-[1.375rem] font-extrabold tracking-[-0.02em] text-balance text-inkt">De rest laten we graag zelf zien.</p>
        <a href={pad('/contact/')} class="mt-4 inline-flex items-center gap-2.5 rounded-md bg-bos px-5 py-3 font-display font-bold text-wit transition-colors hover:bg-bos-diep">
          Demo aanvragen
          <svg class="h-4 w-4" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .app { font-family: "Nunito Variable", "Nunito", "Segoe UI", system-ui, sans-serif; background: #f3f4f6; color: #374151; font-size: 0.875rem; line-height: 1.45; }
  .binnen { max-width: 72rem; margin-inline: auto; padding-inline: 1rem; }
  @media (min-width: 640px) { .binnen { padding-inline: 1.5rem; } }
  .nav { height: 3.75rem; background: #fff; border-bottom: 1px solid #e5e7eb; }
  .navlink { display: flex; align-items: center; padding: 0 0.85rem; border-bottom: 2px solid transparent; color: #4b5563; white-space: nowrap; }
  .navlink.actief { border-color: #1e40af; color: #111827; }
  .titelbalk { padding: 1rem 0; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.08); }
  .titelbalk p { font-size: 1.375rem; color: #111827; }
  .werkruimte { padding: 1.5rem 0 8.5rem; }
  .kaart { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
  .kpi { padding: 1rem 1rem 0.9rem; }
  .waarde { margin-top: 0.1rem; font-size: 1.0625rem; font-weight: 700; color: #111827; white-space: nowrap; }
  @media (min-width: 640px) { .waarde { font-size: 1.25rem; } }
  th { padding: 0.75rem 1rem; border-bottom: 1px solid #e5e7eb; background: #f9fafb; font-weight: 600; color: #374151; white-space: nowrap; }
  td { padding: 0.8rem 1rem; border-bottom: 1px solid #e5e7eb; }
  .rij.binnen-gekomen { animation: binnen 2.4s ease-out; }
  @keyframes binnen { from { background: #fef9c3; } to { background: transparent; } }
  /* Vervaagt de onderkant: genoeg om te zien dat het echt is, niet hoe alles werkt. */
  .sluier {
    position: absolute; inset: auto 0 0; height: 46%;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding: 0 1rem 2.25rem; text-align: center;
    background: linear-gradient(to bottom, rgb(243 244 246 / 0), rgb(243 244 246 / 0.9) 40%, #f3f4f6 62%);
  }
</style>

<script>
  // Melding van de telefoon in de meldflow: telt op bij container 0123.
  document.addEventListener('afvalmeldpunt:melding', () => {
    const rij = document.querySelector<HTMLElement>('.app .rij[data-nr="0123"]');
    const cel = rij?.querySelector<HTMLElement>('[data-open]');
    if (!rij || !cel) return;
    const n = Number(cel.dataset.open) + 1;
    cel.dataset.open = String(n);
    cel.textContent = `${n} open`;
    rij.classList.remove('binnen-gekomen');
    void rij.offsetWidth;
    rij.classList.add('binnen-gekomen');
  });
</script>
