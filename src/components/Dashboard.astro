---
// Het beheeroverzicht, nagebouwd in de opzet van een gewone Laravel-beheeromgeving:
// navigatie, titelbalk, tabs, filters, vier kaarten en een kale tabel per container.
// Bewust sober en in Nunito, niet in de merkstijl van de site. Klik op een container en de
// meldingen klappen eronder open. Meldingen van de telefoon hierboven komen binnen via het
// event "afvalmeldpunt:melding". Alle gegevens zijn demogegevens.
import '@fontsource-variable/nunito/wght.css';
import { merkPaden } from '../lib/merk.mjs';
import { CATEGORIEEN } from '../lib/meldingen.mjs';

const CAT: Record<string, string> = Object.fromEntries(CATEGORIEEN.map((c) => [c.id, c.naam]));
CAT.sensor = 'Bijna vol (sensor)';

type MStatus = 'Open' | 'In behandeling' | 'Afgehandeld';
interface Melding { nr: string; cat: string; bron: 'Bewoner' | 'Sensor'; wanneer: string; foto: boolean; status: MStatus }
interface Container { nr: string; soort: string; locatie: string; wijk: string; status: 'Actief' | 'In onderhoud' | 'Defect'; meldingen: Melding[] }

const containers: Container[] = [
  { nr: '0123', soort: 'Restafval', locatie: 'Kerkstraat 12 (AMP-0123/0124)', wijk: 'Centrum', status: 'Actief', meldingen: [
    { nr: 'M-24-08112', cat: 'bijgeplaatst', bron: 'Bewoner', wanneer: 'vandaag 08:42', foto: true, status: 'Open' },
    { nr: 'M-24-08111', cat: 'vol', bron: 'Bewoner', wanneer: 'vandaag 08:15', foto: false, status: 'Open' },
    { nr: 'S-0123-0412', cat: 'sensor', bron: 'Sensor', wanneer: 'vandaag 06:30', foto: false, status: 'In behandeling' },
  ] },
  { nr: '0124', soort: 'Papier', locatie: 'Kerkstraat 12 (AMP-0123/0124)', wijk: 'Centrum', status: 'Actief', meldingen: [
    { nr: 'M-24-08104', cat: 'vol', bron: 'Bewoner', wanneer: 'gisteren 18:20', foto: false, status: 'Afgehandeld' },
  ] },
  { nr: '0187', soort: 'PMD', locatie: 'Stationsplein 3 (AMP-0187/0188)', wijk: 'Stationsgebied', status: 'Defect', meldingen: [
    { nr: 'M-24-08109', cat: 'defect', bron: 'Bewoner', wanneer: 'vandaag 07:58', foto: true, status: 'In behandeling' },
  ] },
  { nr: '0188', soort: 'Restafval', locatie: 'Stationsplein 3 (AMP-0187/0188)', wijk: 'Stationsgebied', status: 'Actief', meldingen: [] },
  { nr: '0210', soort: 'Restafval', locatie: 'Molenweg 40 (AMP-0210/0211)', wijk: 'Molenwijk', status: 'Actief', meldingen: [
    { nr: 'M-24-08101', cat: 'overig', bron: 'Bewoner', wanneer: 'gisteren 14:02', foto: false, status: 'Afgehandeld' },
  ] },
  { nr: '0211', soort: 'PMD', locatie: 'Molenweg 40 (AMP-0210/0211)', wijk: 'Molenwijk', status: 'In onderhoud', meldingen: [] },
  { nr: '0231', soort: 'PMD', locatie: 'Schoolstraat 7 (AMP-0231)', wijk: 'Molenwijk', status: 'Actief', meldingen: [
    { nr: 'S-0231-0388', cat: 'sensor', bron: 'Sensor', wanneer: 'gisteren 11:30', foto: false, status: 'Afgehandeld' },
  ] },
  { nr: '0245', soort: 'Papier', locatie: 'Beatrixlaan 22 (AMP-0245/0246)', wijk: 'Noord', status: 'Actief', meldingen: [] },
  { nr: '0246', soort: 'Restafval', locatie: 'Beatrixlaan 22 (AMP-0245/0246)', wijk: 'Noord', status: 'Actief', meldingen: [] },
];
const menu = ['Dashboard', 'Containers', 'Meldingen', 'Gebruikers', 'QR-codes', 'Rapportages'];
const tabs = ['Containers', 'Meldingen', 'QR-plaatjes', 'Maandlijst'];
---
<section id="dashboard" class="relative overflow-hidden bg-grond py-20 text-op-donker-sterk sm:py-28" aria-labelledby="dash-kop">
  <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-16">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 id="dash-kop" class="max-w-[14ch] text-[clamp(2rem,1.4rem+2.4vw,3.25rem)] text-wit lg:col-span-6">Alle meldingen, per container</h2>
      <p class="max-w-[32rem] text-lg lg:col-span-5 lg:col-start-8">De beheerder ziet per container wat er gemeld is, waar en wanneer. Elke melding heeft een status, zodat niets blijft liggen.</p>
    </div>

    <div class="app mt-12 overflow-hidden rounded-md sm:mt-16" role="group" aria-label="Het beheeroverzicht van afvalmeldpunt, met demogegevens" data-containers={JSON.stringify(containers)} data-cat={JSON.stringify(CAT)}>
      <div class="nav">
        <div class="binnen flex h-full items-center gap-6">
          <span class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
            <svg viewBox="0 0 48 48" class="h-6 w-6"><g set:html={merkPaden('#1c6a43', '#3f9f64')} /></svg>
            <span class="leading-none"><span class="block text-[0.75rem] font-semibold text-[#1c6a43]">AFVALMELDPUNT</span><span class="block text-[0.5rem] text-[#1c6a43]">Meldingen &amp; containerbeheer</span></span>
          </span>
          <nav class="hidden h-full items-stretch lg:flex" aria-label="Menu van het beheeroverzicht (voorbeeld)">
            {menu.map((m) => <span class={`navlink ${m === 'Containers' ? 'actief' : ''} ${m === 'Rapportages' ? 'hidden xl:flex' : ''}`}>{m}</span>)}
          </nav>
          <span class="ml-auto flex items-center gap-3" aria-hidden="true">
            <span class="zoek hidden md:flex">
              <svg width="14" height="14" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.5" /></svg>
              Zoeken<kbd>Ctrl K</kbd>
            </span>
            <svg class="hidden text-[#4b5563] sm:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5h16v11H8l-4 4z" /></svg>
            <span class="hidden items-center gap-1.5 whitespace-nowrap text-[#374151] sm:flex">B. Hendriks <svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg></span>
            <svg class="text-[#4b5563] lg:hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </span>
        </div>
      </div>

      <div class="titelbalk"><p class="binnen">Beheeroverzicht</p></div>

      <div class="werkruimte">
        <div class="binnen">
          <div class="flex overflow-x-auto border-b border-[#e5e7eb]" aria-hidden="true">
            {tabs.map((t) => <span class={`tab ${t === 'Containers' ? 'actief' : ''}`}>{t}</span>)}
          </div>

          <p class="mt-6 text-[1.375rem] font-bold text-[#111827]">Beheeroverzicht containers</p>
          <p class="mt-1 text-[#4b5563]">Geplaatste containers met hun meldingen van bewoners en vulgraadsensoren, over alle wijken.</p>

          <div class="mt-4 grid gap-2 sm:grid-cols-[17.5rem_15.5rem_11rem]" aria-hidden="true">
            <span class="veld" style="color:#6b7280"><svg width="14" height="14" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.5" /></svg>Containernummer of straat</span>
            <span class="veld justify-between">Demo-gemeente (AMP-0100)<svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></span>
            <span class="veld justify-between">Alle wijken<svg width="10" height="10" viewBox="0 0 10 10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></span>
          </div>

          <dl class="mt-4 grid grid-cols-2 gap-3 xl:grid-cols-4" data-kaarten></dl>

          <div class="kaart mt-4 overflow-hidden">
            <div class="flex flex-wrap items-center gap-2 px-4 py-3">
              {[['alle', 'Alle'], ['melding', 'Met open melding'], ['defect', 'Defect']].map(([id, naam], i) => (
                <button type="button" class="chip" data-filter={id} aria-pressed={i === 0 ? 'true' : 'false'}>{naam}</button>
              ))}
              <span class="ml-1 text-[#374151]" data-telling></span>
              <span class="ml-auto flex gap-2" aria-hidden="true">
                <span class="knop-wit hidden sm:inline-flex"><svg width="14" height="14" viewBox="0 0 16 16"><rect x="2" y="2.5" width="12" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M6 2.5v11M10 2.5v11" stroke="currentColor" stroke-width="1.3" /></svg>Kolommen</span>
                <span class="knop-donker"><svg width="14" height="14" viewBox="0 0 16 16"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>Export</span>
              </span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr>
                    <th class="hidden w-12 sm:table-cell"><span class="vinkje" aria-hidden="true"></span><span class="sr-only">Selecteren</span></th>
                    <th>Container</th>
                    <th class="hidden md:table-cell">Locatie</th>
                    <th class="hidden lg:table-cell">Wijk</th>
                    <th class="hidden sm:table-cell">Status</th>
                    <th class="text-right">Meldingen</th>
                  </tr>
                </thead>
                <tbody data-rijen></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="mt-4 text-sm text-op-donker">Demo-omgeving met voorbeeldgegevens. Klik op een container om de meldingen te zien en af te handelen.</p>
  </div>
</section>

<style>
  /* Systeemstijl in Nunito: dit is de software, niet de site. */
  .app { font-family: "Nunito Variable", "Nunito", "Segoe UI", system-ui, sans-serif; background: #f3f4f6; color: #374151; font-size: 0.875rem; line-height: 1.45; }
  .binnen { max-width: 72rem; margin-inline: auto; padding-inline: 1rem; }
  @media (min-width: 640px) { .binnen { padding-inline: 1.5rem; } }
  .nav { height: 3.75rem; background: #fff; border-bottom: 1px solid #e5e7eb; }
  .navlink { display: flex; align-items: center; padding: 0 0.85rem; white-space: nowrap; border-bottom: 2px solid transparent; color: #4b5563; }
  .navlink.actief { border-color: #1e40af; color: #111827; }
  .zoek { align-items: center; gap: 0.5rem; width: 10.5rem; padding: 0.45rem 0.6rem; border: 1px solid #e5e7eb; border-radius: 6px; color: #4b5563; }
  .zoek kbd { margin-left: auto; padding: 0 0.3rem; border: 1px solid #e5e7eb; border-radius: 4px; font-family: inherit; font-size: 0.6875rem; color: #6b7280; }
  .titelbalk { padding: 1rem 0; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / 0.08); }
  .titelbalk p { font-size: 1.375rem; color: #111827; }
  .werkruimte { padding: 1.5rem 0 2rem; }
  .tab { padding: 0.6rem 1rem; margin-bottom: -1px; border-bottom: 2px solid transparent; color: #4b5563; white-space: nowrap; }
  .tab.actief { border-color: #1e40af; color: #111827; }
  .veld { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.75rem; border: 1px solid #d1d5db; border-radius: 6px; background: #fff; color: #111827; white-space: nowrap; overflow: hidden; }
  .app :global(.kaart) { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
  .app :global(.kpi) { padding: 1rem 1rem 0.9rem; }
  .app :global(.kpi dt) { font-size: 0.8125rem; color: #4b5563; }
  .app :global(.kpi .waarde) { margin-top: 0.1rem; font-size: 1.0625rem; font-weight: 700; color: #111827; white-space: nowrap; }
  @media (min-width: 640px) { .app :global(.kpi .waarde) { font-size: 1.25rem; } }
  .app :global(.kpi .toelichting) { margin-top: 0.25rem; font-size: 0.75rem; color: #4b5563; }
  .chip { padding: 0.4rem 0.8rem; border: 1px solid #e5e7eb; border-radius: 6px; background: #fff; color: #374151; cursor: pointer; }
  .chip:hover { background: #f9fafb; }
  .chip[aria-pressed="true"] { border-color: #9ca3af; background: #f3f4f6; color: #111827; }
  .knop-wit { align-items: center; gap: 0.45rem; padding: 0.5rem 0.85rem; border: 1px solid #d1d5db; border-radius: 6px; background: #fff; color: #374151; }
  .knop-donker { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.9rem; border-radius: 6px; background: #1f2937; color: #fff; font-weight: 600; }
  .app th { padding: 0.75rem 1rem; border-top: 1px solid #e5e7eb; border-bottom: 1px solid #e5e7eb; background: #f9fafb; font-weight: 600; color: #374151; white-space: nowrap; }
  .app :global(.rij td) { padding: 0.8rem 1rem; border-bottom: 1px solid #e5e7eb; color: #374151; }
  .app :global(.rij) { cursor: pointer; }
  .app :global(.rij:hover), .app :global(.rij[data-open="true"]) { background: #f9fafb; }
  .app :global(.rij.binnen-gekomen) { animation: binnen 2.4s ease-out; }
  @keyframes binnen { from { background: #fef9c3; } to { background: transparent; } }
  .app :global(.rij .nr) { color: #111827; }
  .app :global(.vinkje) { display: block; width: 1rem; height: 1rem; border: 1.5px solid #6b7280; border-radius: 3px; background: #fff; }
  .app :global(.uitklap > td) { padding: 0 0.75rem 0.85rem; border-bottom: 1px solid #e5e7eb; background: #f9fafb; }
  @media (min-width: 640px) { .app :global(.uitklap > td) { padding: 0 1rem 1rem 3.5rem; } }
  .app :global(.uitklap table) { width: 100%; border: 1px solid #e5e7eb; border-radius: 6px; background: #fff; border-collapse: separate; border-spacing: 0; overflow: hidden; }
  .app :global(.uitklap th) { padding: 0.5rem 0.75rem; border-top: 0; font-size: 0.8125rem; background: #fff; }
  .app :global(.uitklap .m td) { padding: 0.55rem 0.75rem; border-top: 1px solid #f0f1f3; font-size: 0.8125rem; color: #374151; background: #fff; }
  .app :global(.actie) { padding: 0.25rem 0.6rem; border: 1px solid #d1d5db; border-radius: 5px; background: #fff; color: #374151; font-size: 0.75rem; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .app :global(.actie:hover) { background: #f3f4f6; }
</style>

<script>
  type MStatus = 'Open' | 'In behandeling' | 'Afgehandeld';
  interface Melding { nr: string; cat: string; bron: string; wanneer: string; foto: boolean; status: MStatus }
  interface Container { nr: string; soort: string; locatie: string; wijk: string; status: string; meldingen: Melding[] }
  const app = document.querySelector<HTMLElement>('.app');
  if (app) {
    const containers: Container[] = JSON.parse(app.dataset.containers!);
    const CAT: Record<string, string> = JSON.parse(app.dataset.cat!);
    const rijen = app.querySelector<HTMLElement>('[data-rijen]')!;
    const kaarten = app.querySelector<HTMLElement>('[data-kaarten]')!;
    let filter = 'alle';
    let open: string | null = null;

    const openTel = (c: Container) => c.meldingen.filter((m) => m.status !== 'Afgehandeld').length;
    const mv = (n: number, een: string, meer: string) => `${n} ${n === 1 ? een : meer}`;
    const volgende: Record<MStatus, [string, MStatus] | null> = { Open: ['In behandeling', 'In behandeling'], 'In behandeling': ['Afhandelen', 'Afgehandeld'], Afgehandeld: null };

    const uitklap = (c: Container) => c.meldingen.length === 0
      ? `<tr class="uitklap"><td colspan="6"><p style="padding:.75rem 0 0;color:#4b5563">Geen meldingen voor deze container.</p></td></tr>`
      : `<tr class="uitklap"><td colspan="6"><table><thead><tr><th class="hidden sm:table-cell">Ontvangen</th><th>Melding</th><th class="hidden sm:table-cell">Bron</th><th class="hidden sm:table-cell">Foto</th><th class="hidden sm:table-cell">Status</th><th><span class="sr-only">Actie</span></th></tr></thead><tbody>${c.meldingen.map((m) => `
          <tr class="m"><td class="hidden sm:table-cell" style="white-space:nowrap">${m.wanneer}</td><td>${CAT[m.cat]}<span class="block sm:hidden" style="color:#4b5563">${m.wanneer} &middot; ${m.status}</span></td><td class="hidden sm:table-cell">${m.bron}</td><td class="hidden sm:table-cell">${m.foto ? 'Ja' : 'Nee'}</td><td class="hidden sm:table-cell" style="white-space:nowrap">${m.status}</td>
          <td style="text-align:right">${volgende[m.status] ? `<button type="button" class="actie" data-c="${c.nr}" data-m="${m.nr}">${volgende[m.status]![0]}</button>` : ''}</td></tr>`).join('')}</tbody></table></td></tr>`;

    const teken = (nieuw?: string) => {
      const zichtbaar = containers.filter((c) => filter === 'alle' || (filter === 'melding' ? openTel(c) > 0 : c.status === 'Defect'));
      rijen.innerHTML = zichtbaar.map((c) => {
        const n = openTel(c);
        return `<tr class="rij${c.nr === nieuw ? ' binnen-gekomen' : ''}" data-nr="${c.nr}" tabindex="0" data-open="${c.nr === open}">
          <td class="hidden sm:table-cell"><span class="vinkje" aria-hidden="true"></span></td>
          <td><span class="nr">${c.nr}</span><span class="block md:hidden" style="font-size:.75rem;color:#4b5563">${c.locatie}<span class="sm:hidden"> &middot; ${c.status}</span></span></td>
          <td class="hidden md:table-cell">${c.locatie}</td>
          <td class="hidden lg:table-cell">${c.wijk}</td>
          <td class="hidden sm:table-cell">${c.status}</td>
          <td style="text-align:right">${n ? `${n} open` : '&mdash;'}</td></tr>${c.nr === open ? uitklap(c) : ''}`;
      }).join('');
      app.querySelector('[data-telling]')!.innerHTML = `<strong style="color:#111827">${mv(zichtbaar.length, 'container', 'containers')}</strong> &middot; 1&ndash;${zichtbaar.length} &middot; op eerstvolgende actie`;
      const metOpen = containers.filter((c) => openTel(c) > 0).length;
      const vol = containers.filter((c) => c.meldingen.some((m) => m.cat === 'sensor' && m.status !== 'Afgehandeld')).length;
      const bij = containers.filter((c) => c.meldingen.some((m) => m.cat === 'bijgeplaatst' && m.status !== 'Afgehandeld')).length;
      const defect = containers.filter((c) => c.status === 'Defect').length;
      kaarten.innerHTML = [
        ['Open meldingen', mv(metOpen, 'container', 'containers'), 'in Demo-gemeente (AMP-0100)'],
        ['Bijna vol', mv(vol, 'container', 'containers'), 'volgens de vulgraadsensor'],
        ['Bijplaatsing', mv(bij, 'container', 'containers'), 'afval naast de container gemeld'],
        ['Defect', mv(defect, 'container', 'containers'), 'wacht op reparatie'],
      ].map(([t, w, s]) => `<div class="kaart kpi"><dt>${t}</dt><dd class="waarde">${w}</dd><dd class="toelichting">${s}</dd></div>`).join('');
    };

    rijen.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      const actie = el.closest<HTMLElement>('.actie');
      if (actie) {
        const m = containers.find((c) => c.nr === actie.dataset.c)?.meldingen.find((x) => x.nr === actie.dataset.m);
        if (m && volgende[m.status]) m.status = volgende[m.status]![1];
        teken();
        return;
      }
      const rij = el.closest<HTMLElement>('.rij');
      if (rij) { open = open === rij.dataset.nr ? null : rij.dataset.nr!; teken(); }
    });
    rijen.addEventListener('keydown', (e) => {
      const rij = (e.target as HTMLElement).closest<HTMLElement>('.rij');
      if (rij && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open = open === rij.dataset.nr ? null : rij.dataset.nr!; teken(); }
    });
    app.querySelectorAll<HTMLElement>('[data-filter]').forEach((k) => k.addEventListener('click', () => {
      filter = k.dataset.filter!;
      app.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === k)));
      teken();
    }));
    // Melding van de telefoon in de meldflow: komt binnen bij container 0123.
    document.addEventListener('afvalmeldpunt:melding', (e) => {
      const d = (e as CustomEvent).detail as { nr: string; categorie: string; foto: boolean };
      containers[0].meldingen.unshift({ nr: d.nr, cat: d.categorie, bron: 'Bewoner', wanneer: 'vandaag 09:41', foto: d.foto, status: 'Open' });
      open = containers[0].nr;
      if (filter === 'defect') filter = 'alle';
      app.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.filter === filter)));
      teken(containers[0].nr);
    });
    open = containers[0].nr;
    teken();
  }
</script>
