---
// src/components/SEO.astro  (sitefront-seo)
// Zet in <head> van de basislayout:  <SEO title=... description=... schema={[...]} />
// Regelt: title, description, canonical (met trailing slash), robots, Open Graph, Twitter,
// favicons, hreflang (optioneel) en één JSON-LD @graph met bedrijf + website + pagina.
// noindex komt uit de prop OF uit ignorePaths in seo.config.json (één bron met de sitemap).
// In demomodus (PUBLIC_VOORSTEL=1 of mode "demo"): noindex, geen canonical, geen JSON-LD.
import { seo, business, isDemo, absUrl, href, isIgnored } from '../lib/site';
import { businessNode, websiteNode, webPageNode } from '../lib/schema';

interface Props {
  title: string;                 // paginatitel zonder merk; merk wordt automatisch toegevoegd
  description: string;           // 120-155 tekens, uniek per pagina
  image?: string;                // og-afbeelding: pad in public/, getImage()-src of absolute URL
  imageWidth?: number;           // alleen meegeven bij een eigen afbeelding (standaard: 1200x630)
  imageHeight?: number;
  imageAlt?: string;
  noindex?: boolean;
  fullTitle?: boolean;           // true = title precies zo gebruiken (bijv. homepage)
  canonical?: string;            // alleen bij uitzondering overschrijven
  type?: 'website' | 'article';
  pageType?: string;             // schema-type van de pagina: WebPage, AboutPage, ContactPage, CollectionPage, ...
  published?: string;            // ISO-datum (artikelen)
  modified?: string;             // ISO-datum, alleen als de inhoud echt is gewijzigd
  alternates?: { hreflang: string; href: string }[];   // inclusief de pagina zelf en x-default
  schema?: Record<string, unknown> | Record<string, unknown>[];  // extra nodes (service, breadcrumb, faq, ...)
}

const {
  title, description, image, imageWidth, imageHeight, imageAlt, noindex = false,
  fullTitle = false, canonical, type = 'website', pageType, published, modified, alternates = [], schema,
} = Astro.props;

const lang = (seo as { language?: string }).language || 'nl-NL';
const ogLocale = lang.replace('-', '_');
const fullTitleText = fullTitle || title.includes(business.name) ? title : `${title} | ${business.name}`;
const path = Astro.url.pathname;
const isNoindex = noindex || isIgnored(path);
const canonicalUrl = canonical ? absUrl(canonical) : absUrl(path);
const ogImage = absUrl(image || business.image || '/og-default.jpg');
const ogW = image ? imageWidth : 1200;
const ogH = image ? imageHeight : 630;
const robots = isDemo
  ? 'noindex, nofollow'
  : isNoindex
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const graph = [
  businessNode(),
  websiteNode(),
  webPageNode({ path: new URL(canonicalUrl).pathname, title: fullTitleText, description, type: pageType, image: ogImage, dateModified: modified }),
  ...extra,
];
// </script> in tekst mag de JSON-LD niet breken
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<title>{fullTitleText}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{!isDemo && !isNoindex && <link rel="canonical" href={canonicalUrl} />}
{!isDemo && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={absUrl(a.href)} />)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={business.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={fullTitleText} />
<meta property="og:description" content={description} />
{!isDemo && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={ogImage} />
{ogW && <meta property="og:image:width" content={String(ogW)} />}
{ogH && <meta property="og:image:height" content={String(ogH)} />}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{type === 'article' && published && <meta property="article:published_time" content={published} />}
{type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={href('/favicon-48x48.png')} sizes="48x48" type="image/png" />
<link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
<link rel="sitemap" href={href('/sitemap-index.xml')} />

{!isDemo && !isNoindex && <script type="application/ld+json" set:html={jsonLd} />}
